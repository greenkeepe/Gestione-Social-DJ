{
  "name": "gestione-social-dj-agents",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema multi-agente per la gestione social (Facebook/Instagram) e la strategia marketing del DJ per matrimoni ed eventi.",
  "type": "module",
  "scripts": {
    "master": "tsx agents/master-agent.ts",
    "agent:media": "tsx agents/media-agent.ts",
    "agent:content": "tsx agents/content-agent.ts",
    "agent:publishing": "tsx agents/publishing-agent.ts",
    "agent:leads": "tsx agents/leads-agent.ts",
    "agent:reply": "tsx agents/reply-agent.ts",
    "agent:analytics": "tsx agents/analytics-agent.ts",
    "agent:strategy": "tsx agents/strategy-agent.ts",
    "agent:reelmaker": "tsx agents/reel-maker-agent.ts",
    "svuota-media": "tsx scripts/svuota-media.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "dotenv": "^16.4.5",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
