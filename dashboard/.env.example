# Password per accedere alla dashboard da remoto
DASHBOARD_PASSWORD=cambia-questa-password
# Chiave usata per firmare il cookie di sessione (una stringa lunga a caso)
SESSION_SECRET=cambia-anche-questa-con-una-stringa-lunga-e-casuale

# Repository da cui leggere i dati aggiornati dagli agenti (senza bisogno
# di ridistribuire il sito ad ogni aggiornamento) e su cui scrivere quando
# carichi un nuovo media dalla pagina "Carica media"
GITHUB_REPO=greenkeepe/Gestione-Social-DJ
GITHUB_BRANCH=main
# Personal Access Token con permesso di scrittura sui "Contents" del
# repository (necessario sempre, non solo per repo privati: serve per
# salvare i nuovi media caricati in data/media-library.json)
GITHUB_TOKEN=

# Per caricare foto/video (storage gratuito Cloudflare R2, piano free: 10GB,
# egress sempre gratuito, nessun limite pratico di dimensione file). Questi
# 5 valori sono TUTTI segreti (restano lato server: la pagina "Carica media"/
# "Crea Reel AI" chiede alla dashboard un URL temporaneo di upload, non
# parla mai direttamente con R2 usando queste credenziali). Vedi README >
# "Storage media (Cloudflare R2)" per la guida passo-passo.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# URL pubblico del bucket (es. https://pub-xxxxxxxx.r2.dev)
R2_PUBLIC_BASE_URL=

# Nota: l'Agente Regista (lato GitHub Actions) usa queste stesse 5 variabili
# per caricare il Reel finito — vedi .env.example nella root del repo.

# --- Controllo/rinnovo token Facebook/Instagram dalla dashboard ------------
# Pagina "Utilizzo servizi": mostra quanto manca alla scadenza del token
# Meta e offre un tasto "Rinnova token ora" che lo rigenera da solo (login
# Facebook + salvataggio automatico nel secret GitHub META_PAGE_ACCESS_TOKEN).
# Sono le STESSE variabili già impostate come secrets GitHub Actions (vedi
# .env.example nella root) — qui vanno impostate DI NUOVO, come variabili
# d'ambiente Vercel: sono due runtime separati, non si condividono da soli.
# Se le lasci vuote la dashboard funziona lo stesso, solo senza questa card.
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
# Serve anche un redirect URI registrato come valido nell'app Meta
# (Impostazioni > Facebook Login > Valid OAuth Redirect URIs):
# https://<il-tuo-dominio-vercel>/api/meta-token/callback
# GITHUB_TOKEN/GITHUB_REPO qui sopra devono avere permesso di scrittura sui
# secrets del repository (uno scope "repo" classico, oppure un fine-grained
# PAT con "Secrets: write") perché il salvataggio automatico funzioni; senza
# quel permesso il tasto genera comunque il token, solo da incollare a mano.
#
# Per far aggiornare da solo ANCHE il valore su Vercel (senza incollarlo tu
# a mano) e far ripartire da solo un nuovo deployment così la card mostra
# subito il conto alla rovescia giusto, aggiungi anche queste 2-3 variabili:
# VERCEL_TOKEN: Account Settings > Tokens > Create Token su vercel.com
# VERCEL_PROJECT_ID: Project Settings > General > Project ID
# VERCEL_TEAM_ID: (solo se il progetto è sotto un team/account con più
# progetti) Team Settings > General > Team ID — se il tuo è un account
# personale singolo puoi lasciarlo vuoto.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# --- Contatti locali (email) — pagina "Locali" -------------------------------
# L'Agente Esploratore prepara bozze di email per ristoranti/hotel della zona
# (mai invio automatico); da questa pagina le invii tu con un tap, per davvero,
# dalla tua casella Gmail. Serve una "password per le app" di Google (NON la
# tua password normale): richiede la verifica in due passaggi attiva sul tuo
# account Google, poi su myaccount.google.com > Sicurezza > Password per le
# app, creane una nuova (nome a piacere, es. "Gestione Social DJ") e incolla
# qui sotto la stringa di 16 caratteri che ti mostra.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# --- Invio da Telegram (opzionale, semplifica molto l'uso quotidiano) -------
# Manda una foto o un video al bot Telegram e finisce da solo nella pipeline
# (didascalia scritta dall'AI, Reel montato automaticamente, pubblicazione
# nell'orario migliore) senza passare dalla dashboard. Vedi README >
# "Invio da Telegram" per la guida passo-passo (creare il bot con BotFather,
# trovare il tuo chat id, registrare il webhook).
# Token del bot, da @BotFather
TELEGRAM_BOT_TOKEN=
# Il TUO chat id (solo i messaggi da questo id vengono accettati: chiunque
# altro scriva al bot viene ignorato)
TELEGRAM_ALLOWED_CHAT_ID=
# Stringa segreta a scelta, usata da Telegram per firmare le richieste al
# webhook (evita che qualcun altro possa chiamare l'endpoint fingendosi
# Telegram). Va anche passata come "secret_token" quando registri il webhook.
TELEGRAM_WEBHOOK_SECRET=
