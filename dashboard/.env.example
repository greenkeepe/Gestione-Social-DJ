# Password per accedere alla dashboard da remoto
DASHBOARD_PASSWORD=cambia-questa-password
# Chiave usata per firmare il cookie di sessione (una stringa lunga a caso)
SESSION_SECRET=cambia-anche-questa-con-una-stringa-lunga-e-casuale

# Repository da cui leggere i dati aggiornati dagli agenti (senza bisogno
# di ridistribuire il sito ad ogni aggiornamento) e su cui scrivere quando
# carichi un nuovo media dalla pagina "Carica media"
GITHUB_REPO=greenkeepe/Gestione-Social-DJ
GITHUB_BRANCH=main
# Personal Access Token con permesso di scrittura sui "Contents" del
# repository (necessario sempre, non solo per repo privati: serve per
# salvare i nuovi media caricati in data/media-library.json)
GITHUB_TOKEN=

# Per caricare foto/video (storage gratuito Cloudinary). Questi due valori
# NON sono segreti (finiscono nel codice del browser, è normale): si
# ottengono creando un account gratuito su https://cloudinary.com e un
# "upload preset" impostato su "Unsigned" (Settings → Upload → Add upload
# preset). Vedi README per la guida passo-passo.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
