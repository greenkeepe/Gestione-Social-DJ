# Copia questo file in .env.local per lo sviluppo locale.
# In produzione (Vercel) imposta le stesse variabili come Environment Variables.

# URL del sito, quando sarà disponibile un dominio reale.
# Lasciare vuoto finché non esiste: non va inventato.
# Usata solo lato server (sitemap, robots, metadata, JSON-LD): su Vercel
# va impostata come variabile privata ("Config"), non NEXT_PUBLIC_.
SITE_URL=

# --- Modulo di contatto ("Verifica la disponibilità") -----------------------
# Se non impostata, il modulo valida e registra la richiesta nei log del
# server ma NON invia alcuna email: per attivare l'invio, crea un account su
# https://resend.com, verifica un dominio/mittente e incolla qui la API key.
RESEND_API_KEY=
# Indirizzo che riceve le richieste (default: l'email in data/site.ts)
CONTACT_NOTIFY_EMAIL=
# Mittente verificato su Resend (default: onboarding@resend.dev, solo per test)
CONTACT_FROM_EMAIL=

# --- Analytics (opzionali, si attivano solo se valorizzate) -----------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Dashboard privata /admin/seo (SEO Engine) -------------------------------
# Protegge /admin con Basic Auth (vedi proxy.ts). Senza queste due variabili
# la dashboard risponde sempre "non configurata" invece di restare aperta.
# Variabili privata su Vercel: nessun prefisso NEXT_PUBLIC_.
ADMIN_SEO_USER=
ADMIN_SEO_PASSWORD=

# Le credenziali per la sincronizzazione con Google Search Console
# (GSC_SERVICE_ACCOUNT_KEY, GSC_SITE_URL) NON vanno qui: sono usate solo dal
# workflow GitHub Actions .github/workflows/seo-gsc.yml e vanno impostate
# come GitHub Actions Secrets. Vedi site/docs/seo-engine.md.
