# ===========================================================================
# CREDENZIALI — copia questo file in ".env" (mai committare ".env" reale!)
# In produzione (GitHub Actions / Vercel) questi valori vanno inseriti come
# "Secrets", non nel file .env. Vedi README.md per la guida passo-passo.
# ===========================================================================

# --- Meta (Facebook + Instagram) Graph API -------------------------------
# Ottenuti creando un'app su https://developers.facebook.com
META_APP_ID=
META_APP_SECRET=
# Long-lived Page Access Token della tua Pagina Facebook (dura ~60 giorni).
# La dashboard (pagina "Utilizzo servizi") mostra quanto manca alla scadenza
# e ha un tasto "Rinnova token ora" che lo rigenera da solo — vedi
# dashboard/.env.example per le stesse variabili lato Vercel.
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_BUSINESS_ACCOUNT_ID=

# --- LLM opzionale per testi/caption più intelligenti (facoltativo) --------
# Se lasci vuoto, il Content Agent usa template pre-scritti (zero costo).
# Se lo imposti, i testi vengono generati/migliorati da Claude (costo minimo
# a consumo, non gratuito). Vedi README > "Upgrade path".
ANTHROPIC_API_KEY=

# --- Storage media (Cloudflare R2) ------------------------------------------
# Video grezzi, foto e Reel finiti vivono in un bucket R2 (piano gratuito:
# 10GB storage, egress sempre gratuito, nessun limite pratico di dimensione
# file). Queste 5 variabili servono all'Agente Regista per caricare il Reel
# renderizzato — sono TUTTE segrete (vanno solo nei GitHub Secrets, mai nel
# codice o in chat). Vedi README > "Storage media (Cloudflare R2)".
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# URL pubblico del bucket (es. https://pub-xxxxxxxx.r2.dev, dopo aver
# attivato "Public access" sul bucket — vedi README)
R2_PUBLIC_BASE_URL=

# --- AI Reel Maker (Agente "Regista") ---------------------------------------
# Video grezzo -> Reel verticale pronto per i social. Il rendering gira con
# ffmpeg sul runner GitHub Actions (gratuito), vedi .github/workflows/reel-maker.yml
# e README > "AI Reel Maker".
# Metti "false" per disattivare l'AI Reel Maker senza rimuovere il codice.
# Se lasci vuoto/"true" è attivo.
ENABLE_AI_REEL_MAKER=true

# --- Notifiche Telegram (opzionale) -----------------------------------------
# Se impostate, gli agenti Editore e Regista ti scrivono su Telegram quando
# pubblicano un post o finiscono di montare un Reel. Sono le STESSE 2
# variabili usate per l'ingestion (invio foto/video al bot) — vedi
# dashboard/.env.example e README > "Invio da Telegram".
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# --- Generali ---------------------------------------------------------------
TIMEZONE=Europe/Rome

# Nota: le variabili della dashboard (DASHBOARD_PASSWORD, SESSION_SECRET,
# GITHUB_TOKEN, GITHUB_REPO, GITHUB_BRANCH, e le stesse R2_* qui sopra) sono
# anche in dashboard/.env.example — vanno impostate su Vercel, non qui.
