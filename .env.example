# ===========================================================================
# CREDENZIALI — copia questo file in ".env" (mai committare ".env" reale!)
# In produzione (GitHub Actions / Vercel) questi valori vanno inseriti come
# "Secrets", non nel file .env. Vedi README.md per la guida passo-passo.
# ===========================================================================

# --- Meta (Facebook + Instagram) Graph API -------------------------------
# Ottenuti creando un'app su https://developers.facebook.com
META_APP_ID=
META_APP_SECRET=
# Long-lived Page Access Token della tua Pagina Facebook (dura ~60 giorni,
# lo script scripts/refresh-meta-token.ts te lo ricorda quando sta per scadere)
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_BUSINESS_ACCOUNT_ID=

# --- Google Photos API ------------------------------------------------------
# Progetto su https://console.cloud.google.com, OAuth Client (Desktop app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_PHOTOS_ALBUM_ID=

# --- LLM opzionale per testi/caption più intelligenti (facoltativo) --------
# Se lasci vuoto, il Content Agent usa template pre-scritti (zero costo).
# Se lo imposti, i testi vengono generati/migliorati da Claude (costo minimo
# a consumo, non gratuito). Vedi README > "Upgrade path".
ANTHROPIC_API_KEY=

# --- Dashboard remota --------------------------------------------------------
DASHBOARD_PASSWORD=cambia-questa-password
# Token GitHub (solo lettura "Contents") che permette alla dashboard di
# leggere i dati aggiornati dal repo senza bisogno di ridistribuire il sito
GITHUB_TOKEN=
GITHUB_REPO=greenkeepe/gestione-social-dj
GITHUB_BRANCH=main

# --- Generali ---------------------------------------------------------------
TIMEZONE=Europe/Rome
